<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DogSC.Windows</RootNamespace>
    <AssemblyName>DogSC.Windows</AssemblyName>
    <Version>0.1.21.11</Version>
    <ApplicationIcon>Assets\DogSC.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\DogSC.ico;Assets\DogSC.png" />
    <InternalsVisibleTo Include="DogSC.Windows.SmokeTests" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
</Project>
